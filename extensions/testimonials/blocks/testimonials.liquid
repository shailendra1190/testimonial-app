{% liquid
  assign block_settings = block.settings
  assign testimonial_type = app.metafields.easy_testimonials.metaobject_type.value
%}
{% capture testimonial_cards %}
  {% if block_settings.source == 'dashboard' %}
    {% if testimonial_type != blank %}
      {% for testimonial in metaobjects[testimonial_type].values limit: block_settings.limit %}
        {% render 'testimonial-card', customer_name: testimonial.customer_name.value, review: testimonial.review.value, rating: testimonial.rating.value %}
      {% endfor %}
    {% endif %}
  {% else %}
    {% for i in (1..3) %}
      {% liquid
        assign name_key = 'name_' | append: i
        assign review_key = 'review_' | append: i
        assign rating_key = 'rating_' | append: i
        assign customer_name = block_settings[name_key]
        assign review = block_settings[review_key]
        assign rating = block_settings[rating_key] | plus: 0
      %}
      {% if review != blank %}
        {% render 'testimonial-card', customer_name: customer_name, review: review, rating: rating %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endcapture %}
{% assign testimonial_cards = testimonial_cards | strip %}
{% if testimonial_cards != blank or request.design_mode %}
  <div class="easy-testimonials" {{ block.shopify_attributes }}>
    <div class="easy-testimonials__container">
      <h2 class="easy-testimonials__heading">{{ block_settings.heading | escape }}</h2>
      {% if testimonial_cards != blank %}
        <div class="easy-testimonials__grid">{{ testimonial_cards }}</div>
      {% elsif request.design_mode %}
        <p>{{ 'testimonials.empty' | t }}</p>
      {% endif %}
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name": "Easy Testimonials",
  "target": "section",
  "stylesheet": "testimonials.css",
  "settings": [ { "type": "select", "id": "source", "label": "Testimonial source", "default": "manual", "options": [{ "value": "manual", "label": "Theme editor" }, { "value": "dashboard", "label": "App dashboard" }] }, { "type": "range", "id": "limit", "label": "Maximum testimonials", "min": 1, "max": 50, "step": 1, "default": 6 },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "header",
      "content": "Testimonial 1"
    },
    {
      "type": "text",
      "id": "name_1",
      "label": "Customer name"
    },
    {
      "type": "textarea",
      "id": "review_1",
      "label": "Review"
    },
    {
      "type": "range",
      "id": "rating_1",
      "label": "Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Testimonial 2"
    },
    {
      "type": "text",
      "id": "name_2",
      "label": "Customer name"
    },
    {
      "type": "textarea",
      "id": "review_2",
      "label": "Review"
    },
    {
      "type": "range",
      "id": "rating_2",
      "label": "Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Testimonial 3"
    },
    {
      "type": "text",
      "id": "name_3",
      "label": "Customer name"
    },
    {
      "type": "textarea",
      "id": "review_3",
      "label": "Review"
    },
    {
      "type": "range",
      "id": "rating_3",
      "label": "Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    }
  ]
}
{% endschema %}

